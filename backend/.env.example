# MongoDB Atlas connection string — never commit the real value
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gopratle?retryWrites=true&w=majority

# Local HTTP port for src/server.ts (Vercel invokes the exported Express app)
PORT=4000

# Allowed frontend origin for CORS
# Local:      http://localhost:3000
# Production: https://gopratle-event-platform.vercel.app
FRONTEND_URL=http://localhost:3000

NODE_ENV=development
